{
  "_meta": {
    "platform": "aos8",
    "purpose": "Capability reclassification for the AOS8 configuration API (all mutations are POST with an _action body).",
    "rules": [
      "GET /object/* stays read (config export/show).",
      "POST /object/* config-set operations default to write (gated, body-carrying).",
      "Disruptive/irreversible POST actions (reboot, reload, firmware upgrade/copy-into-device, partition overwrite, purge/clear/reset, revoke/delete/rename/move) are escalated to destructive.",
      "Diagnostic/show POSTs (read_bootinfo, prov_ap_read_bootinfo, aaa_test_server) and backup/export copies (copy_flash_ftp/scp/tftp/awss3, copy_running_*) stay as ordinary body-carrying writes rather than destructive, since the AOS8 JSON API models even reads as POST-with-body."
    ]
  },
  "capabilities": {
    "POST /object/abort_cluster_upgrade": "destructive",
    "POST /object/ap_reprovision": "destructive",
    "POST /object/clear_provisioning_ap_list": "destructive",
    "POST /object/clear_provisioning_params": "destructive",
    "POST /object/clear_snmp_faults": "destructive",
    "POST /object/configuration_device_move": "destructive",
    "POST /object/configuration_node_move": "destructive",
    "POST /object/configuration_node_rename": "destructive",
    "POST /object/configuration_purge_pending": "destructive",
    "POST /object/copy_flash_flash": "destructive",
    "POST /object/copy_flash_system": "destructive",
    "POST /object/copy_flash_usb_partition": "destructive",
    "POST /object/copy_ftp_flash": "destructive",
    "POST /object/copy_ftp_system": "destructive",
    "POST /object/copy_nowait": "destructive",
    "POST /object/copy_running_flash": "destructive",
    "POST /object/copy_scp_flash": "destructive",
    "POST /object/copy_scp_system": "destructive",
