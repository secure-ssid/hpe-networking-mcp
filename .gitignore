# Credentials — never commit.
# `.env.*` is a catch-all: setup_wizard.py and manual edits leave backups such as
# .env.bak.<ts>, .env.broken.<ts>, .env.pre-<change>.<ts>. Those carry live tokens.
# Only explicitly-negated template files may be tracked.
.env
# Any .env sidecar: wizard/doctor backups, pytest swap artifacts, incident
# copies. These hold the same secrets as .env, so match them by prefix
# rather than listing each suffix.
.env.*
!.env.example
!.env.*.example
config/credentials.yaml
.token_cache_*.json

# Docker secrets mounted into the MCP router container (docker-compose.router.yml).
# Only *.example templates and secrets/README.md are tracked.
secrets/*
!secrets/*.example
!secrets/README.md

# Generated local compose overlay (setup_wizard.py --docker); never tracked.
docker-compose.router.local.yml

# Claude local settings (may contain credentials in allowed commands)
.claude/settings.local.json

# Local MCP client configs (often include absolute paths/secrets)
# Keep shared settings in .mcp.json.example and editor-specific *.example files only.
.mcp.json
.mcp.http.json
.claude/mcp.json
.vscode/mcp.json

# Internal runbook PDFs
*.pdf

# Postman collections (large binary-like files — download via resources/README.md)
resources/*.json

# Real device input files (use inputs/*_example.csv as templates instead)
inputs/*.csv
inputs/*.cfg
!inputs/*_example.csv
!inputs/*_template.csv

# macOS metadata
.DS_Store

# Runtime output
state/
outputs/
!state/.gitkeep
!outputs/.gitkeep

# Node (orphan lockfiles from Claude worktree sessions)
package-lock.json
package.json
node_modules/

# Scraped doc sources (regenerate with ingestion scrapers)
ingestion/sources/
ingestion/markdown/
ingestion/markdown_techdocs/
ingestion/markdown_vsg/
ingestion/techdocs_urls.json

# Historical local Docker bind-mount dirs from older Compose files
redis_data/
ollama_data/

# Built indexes — rebuild locally: the OpenAPI index with
# `python scripts/build_spec_index.py` (offline, from the committed
# vendor/openapi corpus), the prose corpus with `ingestion/ingest_docs.py`.
# Neither is published as a release asset.
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Local vendored GreenLake OpenAPI specs (proprietary; fetch via scripts/generate_glp_tools.py --fetch)
ingestion/greenlake_specs/

# Local-only vendor diagram packs (VisioCafe/HPE stencils — do not redistribute)
resources/diagram_icons/private/
resources/diagram_icons/vendors/**
!resources/diagram_icons/vendors/.gitkeep

# Personal/internal document collections (pipeline personal_ingest.py).
# The real store lives outside the repo under ~/.config/hpe-mcp/personal/ —
# these patterns are only a defensive backstop in case a relative data_dir
# is ever pointed at the repo by mistake. Never commit ingested personal or
# internal/proprietary document content or its local vector index.
personal_data/
personal_docs/
*.personal.lancedb/
cli_client/personal/

# Jekyll build artifacts from local docs builds
docs/.sass-cache/
docs/_site/
