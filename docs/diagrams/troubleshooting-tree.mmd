flowchart TD
    start["Something is not working"]
    doctor["Run scripts/doctor.py"]
    local{"Local setup passes?"}
    auth{"401 / 403?"}
    transport{"Connection / 406 / port?"}
    catalog{"Tool missing?"}
    rag{"Docs or API answer stale?"}
    fixlocal["Fix paths, dependencies,<br/>credentials, or local config"]
    fixauth["Check gateway, token URL,<br/>client ID/secret, workspace"]
    fixtransport["Check stdio vs HTTP,<br/>URL, port, headers, allow-lists"]
    fixcatalog["Check toolsets/products,<br/>then rebuild tools index"]
    fixrag["Refresh sources and rebuild<br/>docs/spec indexes"]

    start --> doctor --> local
    local -->|"No"| fixlocal
    local -->|"Yes"| auth
    auth -->|"Yes"| fixauth
    auth -->|"No"| transport
    transport -->|"Yes"| fixtransport
    transport -->|"No"| catalog
    catalog -->|"Yes"| fixcatalog
    catalog -->|"No"| rag
    rag -->|"Yes"| fixrag
