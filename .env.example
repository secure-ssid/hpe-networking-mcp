# hpe-networking-mcp environment template
#
# Copy to `.env` and uncomment only what you use. `scripts/run_http_router.sh`
# sources this file automatically when starting the HTTP router; stdio users
# can point their MCP client config at it or export variables directly.
#
# Rules that hold everywhere:
#   * Credentials never go in this file's committed sibling — keep real
#     values in a git-ignored `.env`, Docker secrets, or
#     config/credentials.yaml.
#   * A variable set explicitly always wins over any *_FILE hint bridged by
#     docker/entrypoint.sh.
#   * Unset means default; nothing here is required for the credential-free
#     quickstart (`python3 scripts/setup_wizard.py --yes --skip-credentials`).

# ── Router surface ────────────────────────────────────────────────────────
# Client-visible tool list size. minimal = 3 router tools (recommended).
#HPE_MCP_ROUTER_MODE=minimal
# Comma-separated backend toolsets. Default: central,glp,rag
#HPE_MCP_TOOLSETS=central,glp,rag
# Optional product backends, loaded only when named here:
# clearpass,mist,apstra,aos8,edgeconnect,uxi,axis,design
#HPE_MCP_PRODUCTS=clearpass,mist
# Write posture: safe-read-only | custom | full-read-write (default custom)
#HPE_MCP_ACCESS_PROFILE=custom
# Shared mode for optional products: read-only (default) | read-write
#HPE_MCP_PRODUCT_ACCESS=read-only
# Legacy global read-only switch; run_http_router.sh sets it to 1 under
# safe-read-only. Prefer HPE_MCP_ACCESS_PROFILE.
#HPE_MCP_READONLY=0

# ── Per-platform write gates (default 0 = writes denied) ──────────────────
# Each gate exposes that platform's write AND destructive tools when set to 1.
# Central and GLP are deny-by-default regardless of HPE_MCP_ACCESS_PROFILE;
# optional products follow HPE_MCP_PRODUCT_ACCESS unless overridden here.
#HPE_MCP_CENTRAL_WRITES=0
#HPE_MCP_GLP_V2BETA1_WRITES=0
#HPE_MCP_AOS8_WRITES=0
#HPE_MCP_EDGECONNECT_WRITES=0
#HPE_MCP_APSTRA_WRITES=0
#HPE_MCP_MIST_WRITES=0
#HPE_MCP_CLEARPASS_WRITES=0
#HPE_MCP_UXI_WRITES=0
#HPE_MCP_AXIS_WRITES=0

# ── HTTP transport (scripts/run_http_router.sh) ───────────────────────────
#MCP_TRANSPORT=streamable-http
# Loopback by default; anything else requires the two allow-lists below and
# fails closed otherwise (see UnsafeHttpBindingError in mcp_servers/shared.py).
#MCP_HOST=127.0.0.1
#MCP_PORT=8010
# Required together when MCP_HOST is not loopback. No wildcard hosts/origins.
#MCP_ALLOWED_HOSTS=mcp.example.com:*
#MCP_ALLOWED_ORIGINS=https://mcp.example.com
# DNS-rebinding protection stays on unless explicitly disabled (not recommended).
#MCP_DNS_REBINDING_PROTECTION=1
# Static bearer token protecting every HTTP path except /livez /readyz /healthz.
# In containers, prefer mounting a secret and setting MCP_HTTP_BEARER_TOKEN_FILE;
# docker/entrypoint.sh bridges it into MCP_HTTP_BEARER_TOKEN.
#MCP_HTTP_BEARER_TOKEN=
# Opt-in /metrics endpoint (bounded JSON snapshot, behind the bearer token too).
#HPE_MCP_METRICS_HTTP=0

# ── Credentials ───────────────────────────────────────────────────────────
# Central + GreenLake OAuth client id/secret live in a YAML file, not env vars.
# Defaults to config/credentials.yaml; containers use /run/secrets/credentials_yaml.
#CREDS_PATH=config/credentials.yaml

# ── Caches ────────────────────────────────────────────────────────────────
# OAuth token cache location. Fails closed if unwritable — no CWD fallback.
#TOKEN_CACHE_DIR=
# Base cache dir when TOKEN_CACHE_DIR is unset (default ~/.cache).
#XDG_CACHE_HOME=

# ── RAG / retrieval backend ───────────────────────────────────────────────
# lancedb (embedded, default) | redis (Redis Stack via docker-compose.yml)
#HPE_MCP_RAG_BACKEND=lancedb
#REDIS_URL=redis://localhost:6379
# Warm embedding models at startup instead of first query.
#HPE_MCP_RAG_PREWARM=0
# Embedding provider override for ingest/embed pipelines.
#HPE_MCP_EMBED_PROVIDERS=
# Nomic task prefixes on embeddings changed the corpus; opt in only on rebuilds.
#HPE_MCP_NOMIC_PREFIXES=0
# Milvus fallback store path (opt-in local client).
#HPE_MCP_MILVUS_PATH=

# ── Juniper Mist ──────────────────────────────────────────────────────────
#MIST_HOST=https://api.mist.com
#MIST_API_TOKEN=
# Session-cookie auth alternative to API tokens (with CSRF token below).
#MIST_SESSION_COOKIE=
#MIST_CSRF_TOKEN=

# ── Aruba ClearPass ───────────────────────────────────────────────────────
#CLEARPASS_BASE_URL=
#CLEARPASS_API_TOKEN=

# ── Aruba Apstra ──────────────────────────────────────────────────────────
#APSTRA_BASE_URL=
#APSTRA_USERNAME=
#APSTRA_PASSWORD=
# Static API token alternative to username/password.
#APSTRA_API_TOKEN=

# ── ArubaOS 8 ─────────────────────────────────────────────────────────────
#AOS8_BASE_URL=
#AOS8_API_TOKEN=
# Username/password session alternative (UIDARUBA cookie flow).
#AOS8_USERNAME=
#AOS8_PASSWORD=
# Client IP pinned for controller session ACLs.
#AOS8_CLIENT_IP=
#AOS8_SESSION_TTL_SECONDS=

# ── EdgeConnect SD-WAN ────────────────────────────────────────────────────
#EDGECONNECT_BASE_URL=
#EDGECONNECT_API_TOKEN=
# Auth header name (default X-Auth-Token).
#EDGECONNECT_AUTH_HEADER=X-Auth-Token
# Pre-9.3 Orchestrator endpoint map is blocked unless explicitly allowed.
#EDGECONNECT_ALLOW_LEGACY_API=0

# ── HPE Aruba UXI ─────────────────────────────────────────────────────────
#UXI_CLIENT_ID=
#UXI_CLIENT_SECRET=
#UXI_BASE_URL=https://api.capenetworks.com
#UXI_TOKEN_URL=

# ── Axis Atmos Cloud ──────────────────────────────────────────────────────
#AXIS_BASE_URL=
#AXIS_API_TOKEN=

# ── GreenLake Platform generated-tool extras ──────────────────────────────
# Regional data-plane host selection for GLP family tools.
#GLP_GENERATED_REGION=
# Overrides wired through pipeline/config.py (rarely needed).
#GLP_TOKEN_URL=
#GLP_BASE_URL=https://global.api.greenlake.hpe.com
# Force-enable the GLP generated tool family outside direct mode.
#HPE_MCP_GLP_GENERATED_TOOLS=0

# ── Safety & behavior toggles ─────────────────────────────────────────────
# Allow placeholder API base URLs despite the outbound URL guard (test rigs only).
#HPE_MCP_ALLOW_PLACEHOLDER_URLS=0
# Bounded session-scoped secret tokenization for model-visible traffic.
#HPE_MCP_TOKENIZE_SECRETS=1
# Normalize MAC addresses in tool responses (opt-in middleware).
#HPE_MCP_NORMALIZE_MACS=0

# ── Diagrams & CLI niceties ───────────────────────────────────────────────
# Extra icon-pack search root for design/diagram tools.
#HPE_MCP_DIAGRAM_ICON_DIR=
# Permit oversized icon packs in diagrams (off by default).
#HPE_MCP_DIAGRAM_ALLOW_LARGE_ICONS=0
# Hard cap on AI-service result characters handed back to clients.
#HPE_MCP_MAX_RESULT_CHARS=
# REPL history file override.
#HPE_MCP_SHELL_HISTORY=
# Explicit MCP client config path for hpe-mcp-client discovery.
#HPE_MCP_CLIENT_CONFIG=
# HTTP router URL used by stdio client recipes when connecting over HTTP.
#HPE_MCP_HTTP_URL=http://127.0.0.1:8010/mcp

# ── Optional local AI service (hpe-mcp-client AI features) ────────────────
# Provider pick: heuristic|openai|anthropic|ollama (heuristic is offline default)
#HPE_MCP_AI_PROVIDER=heuristic
# Model overrides per provider.
#ANTHROPIC_MODEL=
#OPENAI_MODEL=
#OLLAMA_MODEL=llama3.2:latest
# Service endpoints / keys — only if you use those providers.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OLLAMA_HOST=http://localhost:11434
