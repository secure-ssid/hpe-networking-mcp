{
  "openapi": "3.0.3",
  "info": {
    "title": "Fixture Orchestrator API",
    "version": "9.3.1"
  },
  "servers": [
    {
      "url": "https://orchestrator.example.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "token": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Auth-Token"
      }
    }
  },
  "security": [
    {
      "token": []
    }
  ],
  "paths": {
    "/legacy": {
      "delete": {
        "operationId": "deleteLegacy",
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/widgets/{id}": {
      "post": {
        "operationId": "updateWidget",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
