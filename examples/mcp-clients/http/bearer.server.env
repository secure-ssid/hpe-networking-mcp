# Non-loopback streamable HTTP server env, paired with bearer.mcp.http.json.
#
# The router refuses to start on a non-loopback MCP_HOST unless both
# MCP_ALLOWED_HOSTS and MCP_ALLOWED_ORIGINS are set explicitly (no wildcard
# entries). Bearer protection is supported only with streamable-http, not SSE.
#
# Usage:
#   set -a; source examples/mcp-clients/http/bearer.server.env; set +a
#   MCP_PORT=8010 bash scripts/run_http_router.sh

MCP_HOST=mcp.example.test
MCP_PORT=8010
MCP_ALLOWED_HOSTS=mcp.example.test
MCP_ALLOWED_ORIGINS=https://client.example.test
MCP_HTTP_BEARER_TOKEN=replace-with-a-long-random-value
HPE_MCP_ROUTER_MODE=minimal
HPE_MCP_TOOLSETS=central,glp,rag
